PIF_REVIEW_TENANT_ID=
INGESTION_MAX_UPLOAD_BYTES=26214400
# PDFs aus diesem Ordner werden nach zwei stabilen Größenbeobachtungen aufgenommen.
INGESTION_WATCH_FOLDER=
INGESTION_WATCH_INTERVAL_SECONDS=60
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MANUS_FORGE_BASE_URL=
MANUS_FORGE_API_KEY=
SMTP_HOST=
