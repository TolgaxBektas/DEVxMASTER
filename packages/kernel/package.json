{
  "name": "@xmaster-center/kernel",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/db/schema.ts",
      "import": "./dist/db/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@trpc/server": "11.6.0",
    "@xmaster-center/contracts": "workspace:*",
    "drizzle-orm": "0.44.5",
    "express": "4.21.2",
    "jose": "6.1.0",
    "mysql2": "3.15.0",
    "superjson": "1.13.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "24.7.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "2.1.4"
  }
}
