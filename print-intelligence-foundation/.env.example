DATABASE_URL=postgresql+psycopg://print:replace-with-password@postgres:5432/print
STORAGE_BACKEND=s3
STORAGE_PATH=/data
LOCAL_WORK_DIR=/work/print-intelligence
VISION_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-vl:4b
RENDER_DPI=120
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE=print-intelligence:documents
REDIS_VISIBILITY_TIMEOUT=60
REDIS_MAX_ATTEMPTS=3
REDIS_BACKOFF_SECONDS=1
DISCOVERY_MAX_DEPTH=2
DISCOVERY_MAX_PAGES=50
DISCOVERY_MAX_ENTRIES=100
DISCOVERY_TIMEOUT_SECONDS=60
DISCOVERY_REQUEST_DELAY=0.25
DISCOVERY_USER_AGENT=print-intelligence-foundation/1.0
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=print
S3_ACCESS_KEY=replace-with-minio-user
S3_SECRET_KEY=replace-with-minio-password
SERVICE_TOKEN=replace-with-a-long-random-token
AUTH_DISABLED=false
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
