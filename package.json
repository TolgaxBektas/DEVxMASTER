{
  "name": "xmaster-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "format": "pnpm -r run format",
    "db:generate": "pnpm --filter @xmaster-center/kernel build && pnpm --filter @xmaster-center/module-crm build && drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts"
  },
  "devDependencies": {
    "drizzle-orm": "0.44.5",
    "drizzle-kit": "0.31.4",
    "prettier": "3.6.2",
    "tsx": "4.19.1",
    "typescript": "5.9.3",
    "vitest": "2.1.4"
  }
}
